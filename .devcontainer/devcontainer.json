{
  "name": "EcoFlow SHP v1 - VS Code + Home Assistant DEV",
  "dockerComposeFile": "ha.compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/ecoflow_smart_home_panel_v1",
  "runServices": [
    "workspace",
    "bootstrap"
  ],
  "shutdownAction": "none",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "forwardPorts": [
    "homeassistant:8123"
  ],
  "portsAttributes": {
    "8123": {
      "label": "EcoFlow Home Assistant DEV",
      "onAutoForward": "openBrowserOnce",
      "requireLocalPort": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "python --version && python -m pytest --version"
}
